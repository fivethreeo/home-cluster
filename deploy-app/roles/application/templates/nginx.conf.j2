server {
    listen 80;
    listen [::]:80;
    server_name {{ app_domains | join(' ') }};
{% if certbot_enabled | bool %}
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ app_domains | join(' ') }};
    ssl_certificate {{ app_certbot_config_dir }}/live/{{ app_name }}/fullchain.pem;
    ssl_certificate_key {{ app_certbot_config_dir }}/live/{{ app_name }}/privkey.pem;
{% endif %}

{% if app_django_enabled | bool %}
    location /static/ {
{% if app_django_host == inventory_hostname %}
        alias {{ app_home }}/static/;
{% else %}
        proxy_pass {{ app_upstream }};
        proxy_set_header Host $host;
{% endif %}
    }

{% if app_media_enabled | bool %}
    location ^~ /media/ {
{% if app_django_host == inventory_hostname %}
        alias {{ app_home }}/media/;
        autoindex off;
        disable_symlinks on;
        add_header X-Content-Type-Options nosniff always;
{% else %}
        proxy_pass {{ app_upstream }};
        proxy_set_header Host $host;
{% endif %}
    }

{% endif %}
{% if app_django_location != '/' %}
    location = {{ app_django_location.rstrip('/') }} {
        return 308 {{ app_django_location }};
    }
{% endif %}
    location {{ app_django_location }} {
        proxy_pass {{ app_upstream }}{{ '/' if app_django_location != '/' else '' }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{% endif %}
{% for component in [
    {'enabled': app_ts_backend_enabled, 'location': app_ts_backend_location, 'upstream': app_ts_backend_upstream, 'websocket': false},
    {'enabled': app_ts_ws_backend_enabled, 'location': app_ts_ws_backend_location, 'upstream': app_ts_ws_backend_upstream, 'websocket': true}
] %}
{% if component.enabled | bool %}
{% if component.location != '/' %}
    location = {{ component.location.rstrip('/') }} {
        return 308 {{ component.location }};
    }
{% endif %}
    location ^~ {{ component.location }} {
        proxy_pass {{ component.upstream }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if component.websocket %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
{% endif %}
    }
{% endif %}
{% endfor %}
{% if not ((app_django_enabled | bool and app_django_location == '/')
    or (app_ts_backend_enabled | bool and app_ts_backend_location == '/')
    or (app_ts_ws_backend_enabled | bool and app_ts_ws_backend_location == '/')) %}
    location / {
        return 404;
    }
{% endif %}
}
