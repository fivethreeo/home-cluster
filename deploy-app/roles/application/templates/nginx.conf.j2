server {
    listen 80;
    listen [::]:80;
    server_name {{ app_domains | join(' ') }};
{% if certbot_enabled | bool %}
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ app_domains | join(' ') }};
    ssl_certificate {{ app_certbot_config_dir }}/live/{{ app_name }}/fullchain.pem;
    ssl_certificate_key {{ app_certbot_config_dir }}/live/{{ app_name }}/privkey.pem;
{% endif %}

    location /static/ {
        alias {{ app_home }}/static/;
    }

{% if app_media_enabled | bool %}
    location ^~ /media/ {
        alias {{ app_home }}/media/;
        autoindex off;
        disable_symlinks on;
        add_header X-Content-Type-Options nosniff always;
    }

{% endif %}
    location / {
        proxy_pass {{ app_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
