NODE_ENV=production
HOST={{ app_node_component.bind_host | to_json(ensure_ascii=False) }}
PORT={{ app_node_component.port | int }}
APP_NAME={{ app_name | to_json(ensure_ascii=False) }}
DJANGO_INTERNAL_URL={{ (('http://' + (app_bind if app_node_component.host == app_django_host else app_django_address + ':' + (app_django_origin_port | string)) + '/') if app_django_enabled | bool else '') | to_json(ensure_ascii=False) }}
DJANGO_INTERNAL_AUTH_TOKEN={{ (django_internal_auth_token if app_django_enabled | bool else '') | to_json(ensure_ascii=False) }}
DJANGO_SESSION_COOKIE_NAME={{ app_session_cookie_name | to_json(ensure_ascii=False) }}
WS_INTERNAL_URL={{ (('http://' + (app_ts_ws_backend_bind_host if app_node_component.host == app_ts_ws_backend_host else app_ts_ws_backend_address) + ':' + (app_ts_ws_backend_port | string) + '/') if app_ts_ws_backend_enabled | bool else '') | to_json(ensure_ascii=False) }}
WS_INTERNAL_NOTIFY_TOKEN={{ (ws_internal_notify_token if app_ts_ws_backend_enabled | bool else '') | to_json(ensure_ascii=False) }}
{% if app_node_component.name == 'typescript-ws-backend' %}
WS_ALLOWED_ORIGINS={{ app_ws_allowed_origins | join(',') | to_json(ensure_ascii=False) }}
{% endif %}
