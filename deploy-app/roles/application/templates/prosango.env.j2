DJANGO_DEBUG=false
DJANGO_SECRET_KEY={{ django_secret_key | to_json(ensure_ascii=False) }}
DJANGO_ALLOWED_HOSTS={{ app_domains | join(',') | to_json(ensure_ascii=False) }}
DJANGO_SCRIPT_NAME={{ ('' if app_django_location == '/' else app_django_location.rstrip('/')) | to_json(ensure_ascii=False) }}
DJANGO_TS_BACKEND_URL={{ (app_ts_backend_location if app_ts_backend_enabled | bool else '') | to_json(ensure_ascii=False) }}
DJANGO_TS_WS_BACKEND_URL={{ (app_ts_ws_backend_location if app_ts_ws_backend_enabled | bool else '') | to_json(ensure_ascii=False) }}
DJANGO_DATABASE_ENGINE=django.db.backends.postgresql
DJANGO_DATABASE_NAME={{ app_database | to_json(ensure_ascii=False) }}
DJANGO_DATABASE_USER={{ app_database_user | to_json(ensure_ascii=False) }}
DJANGO_DATABASE_PASSWORD={{ app_database_password | to_json(ensure_ascii=False) }}
DJANGO_DATABASE_HOST={{ app_database_host | to_json(ensure_ascii=False) }}
DJANGO_DATABASE_PORT=5432
DJANGO_MEMCACHED_LOCATION={{ (app_memcached_enabled | bool | ternary(app_memcached_location, '')) | to_json(ensure_ascii=False) }}
DJANGO_CACHE_KEY_PREFIX={{ app_name | to_json(ensure_ascii=False) }}
DJANGO_STATIC_ROOT={{ (app_home + '/static') | to_json(ensure_ascii=False) }}
DJANGO_MEDIA_ROOT={{ (app_home + '/media') | to_json(ensure_ascii=False) }}
DJANGO_FILE_UPLOAD_PERMISSIONS=0o640
DJANGO_FILE_UPLOAD_DIRECTORY_PERMISSIONS=0o2750
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_SESSION_COOKIE_SECURE={{ certbot_enabled | bool | ternary('true', 'false') }}
DJANGO_CSRF_COOKIE_SECURE={{ certbot_enabled | bool | ternary('true', 'false') }}
RSBUILD_BASE_URL=/static
CELERY_RESULT_BACKEND={{ celery_result_backend | to_json(ensure_ascii=False) }}
{% include 'celery.env.j2' %}
