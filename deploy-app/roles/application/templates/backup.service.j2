[Unit]
Description=Encrypted database and media backup for {{ app_name }}
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=ansible-app-backup/{{ app_name }}
StateDirectoryMode=0700
ExecStart=/usr/local/sbin/ansible-app-backup {{ app_secrets_dir }}/backup.json run
TimeoutStartSec=6h
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/ansible-app-backup/{{ app_name }}
