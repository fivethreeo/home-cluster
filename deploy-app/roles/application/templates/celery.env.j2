{% set broker = '[' ~ celery_broker_host ~ ']' if ':' in celery_broker_host else celery_broker_host %}
CELERY_BROKER_URL="amqp://{{ app_rabbitmq_user | urlencode | replace('/', '%2F') }}:{{ app_rabbitmq_password | urlencode | replace('/', '%2F') }}@{{ broker }}:5672/{{ app_rabbitmq_vhost | urlencode | replace('/', '%2F') }}"
